# =============================================
# Take Me Live — Environment Variables
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================

# --- Builder.io CMS ---
# https://www.builder.io/c/docs/using-your-api-key
NEXT_PUBLIC_BUILDER_API_KEY=

# --- Site URL ---
# Canonical URL used for sitemap, Open Graph, and JSON-LD
SITE_URL=https://www.takemelive.com
NEXT_PUBLIC_SITE_URL=https://www.takemelive.com

# --- Admin Authentication ---
# Admin login credentials (set these for production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Admin Session ---
# Secret used to sign admin session tokens (generate a random string)
ADMIN_SESSION_SECRET=
